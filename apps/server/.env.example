# Copy this file to apps/server/.env. NEVER commit that .env file.
GOOGLE_CLIENT_ID=PASTE_CLIENT_ID_FROM_GOOGLE_CLOUD
GOOGLE_CLIENT_SECRET=PASTE_CLIENT_SECRET_FROM_GOOGLE_CLOUD
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
FRONTEND_ORIGIN=http://localhost:5173
HOST=localhost
PORT=3000
# The Blogger blog selected for this app; may be changed after verifying blog ID in API.
BLOGGER_BLOG_ID=1346670730934460908
# Generate on your Mac: openssl rand -hex 32
APP_SECRET=GENERATE_RANDOM_64_HEX_CHARACTERS
# Set true only behind properly configured HTTPS reverse proxy.
COOKIE_SECURE=false
